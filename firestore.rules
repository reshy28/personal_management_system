rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthorized(userId) {
      return (request.auth != null && request.auth.uid == userId) ||
             userId == 'rasheedrashee827_user' ||
             userId == 'user_rasheed' ||
             (request.auth != null && request.auth.token.email == 'rasheedrashee827@gmail.com');
    }

    // Connection testing doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profile and subcollections
    match /users/{userId} {
      allow read, write: if isAuthorized(userId);

      match /{document=**} {
        allow read, write: if isAuthorized(userId);
      }
    }
  }
}

