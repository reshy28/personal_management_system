{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with financial preferences and default settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "defaultMonthlySalary": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "defaultMonthlySalary"]
    },
    "Salary": {
      "title": "Salary",
      "description": "Monthly salary and additional income record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "monthYear": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "maxLength": 7 },
        "baseSalary": { "type": "number" },
        "receivedDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "bonusIncome": { "type": "number" },
        "freelanceIncome": { "type": "number" },
        "otherIncome": { "type": "number" },
        "totalIncome": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "monthYear", "baseSalary", "totalIncome"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Daily expense transaction",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "monthYear": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "maxLength": 7 },
        "paymentMethod": { "type": "string", "maxLength": 30 },
        "isDebtSettlement": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "amount", "category", "date", "monthYear", "paymentMethod"]
    },
    "Loan": {
      "title": "Loan",
      "description": "Active or completed loan and EMI commitment",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "loanName": { "type": "string", "maxLength": 100 },
        "provider": { "type": "string", "maxLength": 100 },
        "originalAmount": { "type": "number" },
        "tenureMonths": { "type": "number" },
        "emiAmount": { "type": "number" },
        "startDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "endDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "paidEmisCount": { "type": "number" },
        "outstandingPrincipal": { "type": "number" },
        "nextDueDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "status": { "type": "string", "enum": ["Active", "Completed"], "maxLength": 20 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "loanName", "provider", "originalAmount", "tenureMonths", "emiAmount", "outstandingPrincipal", "status"]
    },
    "EmiPayment": {
      "title": "EmiPayment",
      "description": "Record of actual EMI installment paid for a month",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "loanId": { "type": "string", "maxLength": 128 },
        "loanName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "paymentDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "monthYear": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "maxLength": 7 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "loanId", "loanName", "amount", "paymentDate", "monthYear"]
    },
    "Saving": {
      "title": "Saving",
      "description": "Savings account or investment contribution",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "monthYear": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "maxLength": 7 },
        "type": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "amount", "date", "monthYear", "type"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Monthly category budget limit",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "monthYear": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "maxLength": 7 },
        "category": { "type": "string", "maxLength": 50 },
        "budgetAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "monthYear", "category", "budgetAmount"]
    },
    "UpcomingBill": {
      "title": "UpcomingBill",
      "description": "Recurring monthly bills like rent, credit cards, and utilities",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "dueDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "monthYear": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "maxLength": 7 },
        "isPaid": { "type": "boolean" },
        "paidDate": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "category", "amount", "dueDate", "monthYear"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root document for user profile and settings"
    },
    "/users/{userId}/salaries/{salaryId}": {
      "schema": "Salary",
      "description": "Monthly salary and income records for the user"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Daily expense transactions for the user"
    },
    "/users/{userId}/loans/{loanId}": {
      "schema": "Loan",
      "description": "Active and completed loan accounts and EMI commitments for the user"
    },
    "/users/{userId}/emiPayments/{emiPaymentId}": {
      "schema": "EmiPayment",
      "description": "Actual EMI payments paid by the user"
    },
    "/users/{userId}/savings/{savingId}": {
      "schema": "Saving",
      "description": "Savings and investment contributions for the user"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "Category budget allocations for the user"
    },
    "/users/{userId}/upcomingBills/{billId}": {
      "schema": "UpcomingBill",
      "description": "Scheduled monthly bills and dues for rent, credit cards, and utilities"
    }
  }
}
